import re
import html
import requests

BOARD_TOKEN = "RedwoodMaterials"


def fetch_jobs(board_token: str) -> list:
    url = f"https://boards-api.greenhouse.io/v1/boards/{board_token}/jobs?content=true"
    response = requests.get(url)
    response.raise_for_status()
    data = response.json()
    return data["jobs"]


def clean_description(html_text: str) -> str:
    """
    Nettoise une description HTML pour l'affichage.
    Greenhouse encode parfois le contenu deux fois, donc on décode
    les entités HTML deux fois pour être sûr de tout attraper.
    """
    # Décodage 1 : &amp;gt; -> &gt;   /   &amp;nbsp; -> &nbsp;
    text_decoded = html.unescape(html_text)

    # Décodage 2 : &gt; -> >   /   &nbsp; -> espace insécable
    text_decoded = html.unescape(text_decoded)

    # Retire les vraies balises HTML (maintenant décodées)
    text_without_tags = re.sub(r"<[^>]+>", " ", text_decoded)

    # Nettoie les espaces multiples résiduels
    text_clean = re.sub(r"\s+", " ", text_without_tags).strip()

    return text_clean


if __name__ == "__main__":
    jobs = fetch_jobs(BOARD_TOKEN)

    print(f"{len(jobs)} offres trouvées pour le board '{BOARD_TOKEN}'\n")
    print("=" * 80)

    for job in jobs:
        titre = job["title"]
        lieu = job["location"]["name"]
        description_brute = job.get("content", "")
        description = clean_description(description_brute)
        apercu_description = description[:300]

        print(f"Titre       : {titre}")
        print(f"Lieu        : {lieu}")
        print(f"Description : {apercu_description}...")
        print("=" * 80)